# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI (Qwen — primary; OpenAI-compatible; also used for KB embeddings)
QWEN_API_KEY=your-qwen-api-key

# ── AI provider ───────────────────────────────────────────────────────────────
# The app speaks the OpenAI-compatible dialect, so any provider offering that
# API works by setting these three — no code change. AI_* wins over QWEN_*.
#
# DashScope is region-split and a key is valid for exactly ONE region:
#   mainland China  https://dashscope.aliyuncs.com/compatible-mode/v1      (default)
#   international   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# The mainland host is NOT reachable from most overseas hosting, Vercel
# included, so a deployment there needs an international account.
#
# AI_API_KEY=
# AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
# AI_MODEL_STRONG=qwen-max
#
# Changing the embedding model or dimensions invalidates every stored vector —
# the Qdrant collection must be re-ingested (npm run kb:ingest).
# AI_EMBEDDING_MODEL=text-embedding-v3
# AI_EMBEDDING_DIMENSIONS=1024

# Knowledge base vector store (Qdrant Cloud — RAG features no-op if unset)
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@novara.vip

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Cron security (any long random string)
CRON_SECRET=your-cron-secret

# Knowledge base admin (runtime doc ingest via POST /api/kb/ingest; falls back to CRON_SECRET)
KB_ADMIN_SECRET=your-kb-admin-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Community: enable native WeChat share buttons (needs WeChat JS-SDK + official
# account). Copy-link + QR work regardless. Set to 1 to show the WeChat buttons.
NEXT_PUBLIC_WECHAT_SHARE_ENABLED=0
